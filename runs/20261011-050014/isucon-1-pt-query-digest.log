#    SHOW CREATE TABLE `isuride`.`chairs`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'chair_distance_totals'\G
#    SHOW CREATE TABLE `isuride`.`chair_distance_totals`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'chair_models'\G
#    SHOW CREATE TABLE `isuride`.`chair_models`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'rides'\G
#    SHOW CREATE TABLE `isuride`.`rides`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'ride_statuses'\G
#    SHOW CREATE TABLE `isuride`.`ride_statuses`\G
# EXPLAIN /*!50100 PARTITIONS*/
SELECT c.id, d.last_latitude, d.last_longitude, m.speed
FROM chairs c
LEFT JOIN chair_distance_totals d ON d.chair_id = c.id
LEFT JOIN chair_models m ON m.name = c.model
LEFT JOIN rides previous ON previous.id = (
	SELECT id FROM rides WHERE chair_id = c.id
	ORDER BY updated_at DESC, id DESC LIMIT 1
)
WHERE c.is_active = TRUE
AND (
	previous.id IS NULL OR (
		EXISTS (
			SELECT 1 FROM ride_statuses
			WHERE ride_id = previous.id AND status = 'COMPLETED'
		)
		AND NOT EXISTS (
			SELECT 1 FROM ride_statuses
			WHERE ride_id = previous.id AND chair_sent_at IS NULL
		)
	)
)\G

