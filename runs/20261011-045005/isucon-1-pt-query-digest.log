# EXPLAIN /*!50100 PARTITIONS*/
SELECT chairs.id, chairs.name, chairs.model, location.latitude, location.longitude
		FROM chairs
		JOIN chair_locations AS location ON location.id = (
		    SELECT id FROM chair_locations
		    WHERE chair_id = chairs.id ORDER BY created_at DESC LIMIT 1
		)
		WHERE chairs.is_active = TRUE\G

