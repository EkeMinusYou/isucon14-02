[Unit]
Description=isuride stateless matching solver
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
Environment=GOGC=300
Environment=GOMEMLIMIT=2GiB
EnvironmentFile=/home/isucon/matching-worker.env
ExecStart=/home/isucon/matching-worker
Restart=on-failure
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
