[Unit]
Description=isuride-matcher
After=nginx.service
Requires=nginx.service

[Service]
User=isucon
Group=isucon
EnvironmentFile=/home/isucon/env.sh

ExecStart=/bin/sh -c "while true; do curl -s --resolve isuride.xiv.isucon.net:443:127.0.0.1 https://isuride.xiv.isucon.net/api/internal/matching; sleep 0.25; done"
ExecStop=/bin/kill -s QUIT $MAINPID

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
